;; ============================================================
;;  yamy (.mayu) 相当の設定を kanata に移植
;;  正本: .mayu + 104on109.mayu （TAGA Nayuta 氏オリジナル）
;;
;;  方針（重要・前回からの変更）:
;;    ★OSのキーボードレイアウトは JIS(106/109) のまま使う。
;;      前回「OSを101(US)にする」案は誤り。yamyは一度もOSを偽らず、
;;      109のまま記号キーをソフトで入れ替えていた(=104on109.mayu)。
;;      OSを101にすると 変換/無変換/¥/カタカナ/半全 が US配列で行き場を
;;      失い HANJA/YEN/K0xB1 等のゴミ化＋不安定の原因になっていた。
;;    ・記号の JIS→US 入れ替えは kanata 内で (fork)+(unicode) で再現。
;;      → レイアウト非依存。yamyの $COMMERCIAL_AT 等の文字出力に相当。
;;    ・IMEは A-grv の小細工を廃止。変換/無変換キーを「そのまま」OSへ流す。
;;      → IME側で「変換=ON / 無変換=OFF」に割当ててあれば従来通り動く。
;;        (MS-IME/Google日本語入力の標準的な設定。もし切替らなければIME設定で割当を)
;; ============================================================

(defcfg
  process-unmapped-keys yes   ;; defsrc に無いキーは素通り
  concurrent-tap-hold yes     ;; SandS 等のロール入力を成立させる
  danger-enable-cmd yes       ;; 外部コマンド実行を許可（cmd_allowed ビルド必須。変換/無変換+クリック・g の clipopen 用）
  ;; windows-sync-keystates は撤去。英数→CtrlはScancode Mapで解決済みで保険不要。
  ;; この機能はtap-hold/unicode出力キー(例:\キー)を誤って強制リリースし
  ;; "Releasing in Windows: BACKSLASH" 等のエラーと誤動作を起こすため。
  ;; エラーのトースト通知を止める(GUI版のみ有効)。v1.12.0 の llhook 押下状態照合が
  ;;   ろ/NumLockオフのテンキー等で "Unexpected keycode is pressed in kanata but not in Windows"
  ;;   を誤検出して頻繁に通知するため(実害なし。jtroo/kanata#2115)。
  ;;   次リリースで `windows-sync-keystates none`(#2122)が使えるようになったら、そちらへ移行してこれは戻す。
  notify-error no
)

;; tap / hold のタイミング(ms)
(defvar
  tt 200
  ht 200
)

(defalias
  ;; --- SandS: Space 単独=Space / 押しっぱ=Shift ---
  sas (tap-hold $tt $ht spc lsft)

  ;; --- mod0(nav)レイヤ: 変換/無変換 を押している間だけ nav ---
  ;;     単独タップはキー自体(変換/無変換)をOSへ送る → IMEのON/OFFはIME設定任せ
  ;; tap は IMEキー＋「IME状態マーカー」を nvim へ送る(状態表示用・全部ファンクションキー)。
  ;;   変換=toggle → S-f9(<F21>/<S-F9>) / 無変換=OFF → S-f8(<F20>/<S-F8>) / カナ=ON → S-f7(後で追加)
  m0h (tap-hold $tt $ht (macro henk S-f9) (layer-while-held nav))        ;; 変換  : tap=変換(IME toggle)+marker / hold=nav
  m0m (tap-hold $tt $ht (macro mhnk S-f8) (layer-while-held nav))    ;; 無変換: hold=nav(変換と同じ) / tap=無変換(IME OFF)+marker(S-f8=F20)。Escは送らずnvim側でF20受信時にstopinsert+補完消し(他アプリへの副作用回避)

  ;; --- 記号 JIS→US (104on109.mayu の def subst 相当) ---
  ;;     (fork 通常 シフト時 (lsft rsft)) でシフト状態に応じて出し分け。
  ;;     文字は (unicode ...) でレイアウト非依存に出力。
  bq  (fork (unicode r#"`"#) (unicode r#"~"#) (lsft rsft))  ;; 半角/全角 → ` / ~
  k2  (fork 2 (unicode r#"@"#) (lsft rsft))                ;; 2 / @
  k6  (fork 6 (unicode r#"^"#) (lsft rsft))                ;; 6 / ^
  k7  (fork 7 (unicode r#"&"#) (lsft rsft))                ;; 7 / &
  k8  (fork 8 (unicode r#"*"#) (lsft rsft))                ;; 8 / *
  k9  (fork 9 (unicode r#"("#) (lsft rsft))                ;; 9 / (
  k0  (fork 0 (unicode r#")"#) (lsft rsft))                ;; 0 / )
  kmn (fork (unicode r#"-"#) (unicode r#"_"#) (lsft rsft)) ;; - / _
  keq (fork (unicode r#"="#) (unicode r#"+"#) (lsft rsft)) ;; JIS^キー → = / +
  klb (fork (unicode r#"["#) (unicode r#"{"#) (lsft rsft)) ;; JIS@キー → [ / {
  krb (fork (unicode r#"]"#) (unicode r#"}"#) (lsft rsft)) ;; JIS[キー → ] / }
  ksc (fork (unicode r#";"#) (unicode r#":"#) (lsft rsft)) ;; ; / :

  ;; --- 記号 兼 修飾(押しっぱ) ---
  ;;   Colon(JIS:キー): tap=' / "  hold=Ctrl   (.mayu: mod Control += !!Colon)
  ;;   ]キー(JIS]):     tap=\ / |  hold=Alt    (.mayu: mod Alt += !!RightSquareBracket)
  apo (fork (unicode r#"'"#) (unicode r#"""#) (lsft rsft))
  bsl (fork (unicode r#"\"#) (unicode r#"|"#) (lsft rsft))
  col (tap-hold $tt $ht @apo lctl)
  brk (tap-hold $tt $ht @bsl lalt)

  ;; --- 変換/無変換+g: WT で選択中の文字列をコピーして clipopen で開く(nav レイヤ) ---
  opn (macro C-S-c 100 (cmd wsl.exe -e /home/motoki/.local/bin/clipopen))
)

;; カナ(カタカナ/ひらがな)キー: winIOv2 バイナリ + deflocalkeys-winiov2 で掴む。
;;   winIOv2 は VK コードで指定(LLHOOK の scancode ではない)。カナ = VK_DBE_KATAKANA = 0xF1 = 241。
;;   ※ kanata_windows_tty_winIOv2_x64.exe (v1.12.0, #1893含む) で起動すること。
(deflocalkeys-winiov2
  kata 241
)

;; 上書きする物理キーだけ列挙（kanata名は US配列スキャンコード基準）
;;   grv =半角全角 / equal=JIS^ / lbrc=JIS@ / rbrc=JIS[ / bksl=JIS] / apos=JIS:
(defsrc
  spc
  henk mhnk kata
  grv  2 6 7 8 9 0  -  =  lbrc  rbrc  ;  apos  bksl
  ralt rmet apps
  mlft              ;; 変換/無変換+クリック用。マウス入力の追加/削除は kanata 再起動が必要(リロードでは効かない)
  f13 f14 f15 f16
  ro kprt
)

(deflayermap (base)
  ;; ★英数(CapsLock)→Ctrl は kanataで拾うと固着するためレジストリ(Scancode Map)へ移動。
  ;;   caps_to_lctrl.reg を結合＋再起動で、物理英数キーはハード段階で本物のLeftCtrlになる。
  ;;   kanataはそれを素通しするだけ（defsrcにcaps無し）。
  spc   @sas        ;; SandS
  henk  @m0h        ;; 変換   : tap=変換(IME) / hold=nav
  mhnk  @m0m        ;; 無変換 : tap=無変換(IME) / hold=nav
  kata  (macro S-f7 kata)  ;; カナ: ONマーカー(S-f7=WTで<F19>)を先送り→kata(実カナキー=IME ON)。順序でmarkerがIMEに飲まれるのを回避

  ;; 記号 JIS→US
  grv   @bq
  2     @k2
  6     @k6
  7     @k7
  8     @k8
  9     @k9
  0     @k0
  -     @kmn
  =     @keq        ;; JIS ^ キー
  lbrc  @klb        ;; JIS @ キー
  rbrc  @krb        ;; JIS [ キー
  ;     @ksc        ;; ; キー
  apos  @col        ;; JIS : キー (tap=' / hold=Ctrl)
  bksl  @brk        ;; JIS ] キー (tap=\ / hold=Alt)

  ;; 仮想マウスボタン
  ralt  mlft        ;; 右Alt → 左クリック
  rmet  mmid        ;; 右Win → 中クリック
  apps  mrgt        ;; アプリケーションキー → 右クリック

  ;; kanata v1.12 の押下状態照合(llhook win_synchronize_keystates)は、kanata 内部の
  ;;   キーコード→VK 変換で GetAsyncKeyState を引く。以下のキーはその VK が Windows の
  ;;   実 VK と食い違い「押しているのに押されていない」と誤判定され、
  ;;   "Unexpected keycode is pressed in kanata but not in Windows ..." 通知が出る。
  ;;   → そのキーコード自体を OS へ出さない割当にして回避する。
  ;;   ろ(Intl1): kanata は VK 0xC1(ABNT_C1) で照合、JIS の実 VK は 0xE2(OEM_102)
  ro    (fork (unicode r#"\"#) (unicode r#"_"#) (lsft rsft))  ;; ろ → \ / Shift で _
  ;;   テンキーEnter(KpEnter): kanata は未割当 VK 232(VK_KPENTER_FAKE)で照合＝常に未押下扱い
  kprt  ret         ;; テンキーEnter → 通常Enter

  ;; --- 4キーマクロパッド (ch57x 1189:8890) -------------------------
  ;;   パッド本体には素の F13〜F16 だけを焼いてある。
  ;;   理由: このファームはマクロ列の「先頭キーにしか modifier が効かない」ため
  ;;         S-f1,S-f2,S-f1 を直接焼くと 2打目以降が素の F1/F2 になりヘルプが開く。
  ;;   なので意味付けは全部ここで行う＝割当変更にパッド再書き込みが要らない。
  f13 (macro S-f1 S-f2 S-f1)   ;; pad1 : 変換+c 相当 → nvim ClaudePick
  f14 (macro S-f1 S-f2 S-f3)   ;; pad2 : 変換+m 相当 → nvim ClaudeAttnSwitch
  f15 (mwheel-up   33 120)     ;; pad3 : 変換+u 相当 → ホイール上(押しっぱ連続)
  f16 (mwheel-down 33 120)     ;; pad4 : 変換+d 相当 → ホイール下
)

;; 変換/無変換 を押している間のナビゲーション
(deflayermap (nav)
  h  left
  j  down
  k  up
  l  rght
  o  A-tab          ;; ウィンドウ切替
  i  A-S-tab        ;; 逆方向
  r  lrld           ;; 設定リロード
  ;; マウスホイール: Claude端末(TUI=nvimスクロールバック無し)や任意アプリを
  ;; ポインタ下でスクロール。押しっぱ=100ms毎に連続=1画面以上どこまでも遡れる。
  ;; ※OSホイールなので「マウスポインタが乗っているウィンドウ」に飛ぶ点だけ注意。
  u  (mwheel-up   33 120)  ;; 変換+u : ホイール上(1ノッチ, 押しっぱ連続)
  d  (mwheel-down 33 120)  ;; 変換+d : ホイール下
  ;; Claude系/explorer/端末Esc: F13〜F15 の「3打」で送る。全キーがファンクションキー＝
  ;; IME もブラウザも絶対に奪わない → 日本語入力中でも WT/ttyd/全モードで確実に効く。
  ;; 押す側は 変換+<文字> のまま(kanataが内部で3打送るだけ)。
  ;; 体系: F13(nvim leader) → 第2キー(F14=Claude群 / F15=ツール群) → 第3キー(選択)。27枠まで拡張可。
  c   (macro S-f1 S-f2 S-f1)  ;; 変換+c   → nvim: ClaudePick(Claudeタスク一覧)  [F13 F14 F13]
  n   (macro S-f1 S-f2 S-f2)  ;; 変換+n   → nvim: ClaudeAttnFocus(Claude待ちへ)  [F13 F14 F14]
  m   (macro S-f1 S-f2 S-f3)  ;; 変換+m   → nvim: ClaudeAttnSwitch(N代替)        [F13 F14 F15]
  e   (macro S-f1 S-f3 S-f1)  ;; 変換+e   → nvim: explorer(cwd)で開く            [F13 F15 F13]
  esc (macro S-f1 S-f3 S-f2)  ;; 変換+Esc → nvim: 端末へ literal Esc            [F13 F15 F14]
  v   (macro S-f1 S-f3 S-f3)  ;; 変換+v   → nvim: 今の md を Vivify で開く       [F13 F15 F15]
  b   (macro S-f1 S-f1 S-f1)  ;; 変換+b   → nvim: Claude の右 dock 差分⇔Board   [F13 F13 F13]
  ;   (macro S-f1 S-f1 S-f2)  ;; 変換+;   → nvim: 過去の会話・日記を検索 :CCSearch [F13 F13 F14]
  ;; 変換+g → WT で選択中の文字列を Ctrl+Shift+C でコピー → WSL の clipopen が中からパス/URL を
  ;;          切り出して開く(ファイル=Vivify、URL=ブラウザ。相対パスは非対応)。選択は手で行う(自動クリックは不安定だった)。
  ;;          nvim の中はマウスを nvim が取るので、そちらは nvim の Ctrl+クリック(21_keymap.lua)を使う。
  ;;          Enter にも割り当てたが不安定だったので外した(メイン Enter が kprt 扱いになり、kprt は
  ;;          状態照合バグで途中リセットされる疑い)。
  g   @opn
  ;; 変換/無変換+クリック → その位置を3連クリック(WT が行を選択) → Ctrl+Shift+C でコピー → clipopen(中身は @opn と同じ。macro は入れ子不可なので展開)。
  ;;   行の中からパス/URL を切り出すので、行内のどこをクリックしてもよい。間隔 50ms(30ms は単語選択に化けた)。
  mlft (macro mlft 50 mlft 50 mlft 100 C-S-c 100 (cmd wsl.exe -e /home/motoki/.local/bin/clipopen))
  ;; mod0+c(CapsLock)は撤去。JISの英数キー=IMEトグルを兼ねるため日本語に化けるので。
  ;; S-M0-hjkl(行選択)は Shift 物理併用で自動的に S-矢印 になる
)

;; 無変換 hold も nav（変換と同じ動き）。旧 nav2(無変換+hjkl=nvim窓移動)は 2026-10-22 に廃止。

;; 同時押し(chord): f+j を同時に押す → Esc
;;   50ms以内に両方押されたら成立。all-released=両方離すまで保持。
;;   末尾(nav)= navレイヤ(j=下矢印)では誤爆防止のため無効化。
(defchordsv2
  (f j) esc 50 all-released (nav)
)

;; ============================================================
;;  未移植 / 要実機確認:
;;   - ろ(_)キー → 右Shift  (104on109: *ReverseSolidus = *RightShift)
;;       kanataのキー名が未確定。`kanata.exe --debug` でこのキーを押し、
;;       出てくる名前を確認 → defsrc に追加し rsft を割当て。
;;   - ¥キー: yamyでも未変更のため素通り（必要なら後で）。
;;
;;  動作確認ポイント（再起動後）:
;;   1) OSのキーボードが JIS(106/109) に戻っているか
;;   2) 英数→Ctrl が固着しないか（しばらく使ってCtrl固着が出ないか）
;;      → 出るなら caps をkanataから外しレジストリ(Caps→Ctrl)へ移す
;;   3) Shift+2=@ など記号がUS配列で出るか
;;   4) 変換/無変換でIMEがON/OFFするか（しなければIME側で割当）
;; ============================================================
